<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HealthApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/health_primary</item>
        <item name="colorOnPrimary">@color/health_on_primary</item>
        <item name="colorPrimaryContainer">@color/health_primary_container</item>
        <item name="android:colorBackground">@color/health_background</item>
        <item name="colorSurface">@color/health_surface</item>
        <item name="android:navigationBarColor">@color/health_surface</item>
        <item name="android:statusBarColor">@color/health_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.HealthApp.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/health_surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/health_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="TextAppearance.HealthApp.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/health_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HealthApp.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/health_text_secondary</item>
    </style>

    <style name="TextAppearance.HealthApp.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/health_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HealthApp.CardValue" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/health_primary</item>
    </style>

    <style name="TextAppearance.HealthApp.Placeholder" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/health_text_secondary</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>
